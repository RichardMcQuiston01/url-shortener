# Copy to .env and fill in. Never commit .env.
# The app refuses to start if a required value is missing or too short,
# and the error names the variable (never the value).

# Public base URL, no trailing slash. Used to build short URLs.
BASE_URL=https://go.richardmcquiston.com

# Admin UI password, at least 16 characters.     openssl rand -base64 24
ADMIN_PASSWORD=

# Bearer key for /api/*, at least 32 characters.  openssl rand -base64 32
API_KEY=

# Signs admin session cookies, at least 32 characters.  openssl rand -base64 48
SESSION_SECRET=

# SQLite file. Keep it under /data so it lives on the volume.
DATABASE_PATH=/data/links.db

# Listen port inside the container. If you change it, change `expose` in
# docker-compose.yml and the Caddy upstream to match.
PORT=8080

# Where GET / redirects. Leave empty for a plain 404.
HOME_REDIRECT_URL=

# true behind Caddy, so the client IP comes from X-Forwarded-For.
TRUST_PROXY=true

# Name of the Docker network Caddy uses (docker network ls). Read by
# docker-compose.yml, not by the app.
PROXY_NETWORK=hired-hand-net
